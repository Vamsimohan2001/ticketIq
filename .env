# Copy to .env (scripts/setup does this for you). Every value is optional: the defaults run the whole app offline.

# --- AI provider: mock (default, no key, no cost) | gemini | ollama ---
AI_PROVIDER=mock
AI_ENABLED=true

# Gemini (https://aistudio.google.com/apikey). Only needed when AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Ollama (local models). Only needed when AI_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- AI behaviour ---
EMBEDDING_DIMENSIONS=768
AI_CONFIDENCE_THRESHOLD=0.6
# Leave unset to use the provider's default (mock 0.5, ollama 0.7, gemini 0.75)
# AI_SIMILARITY_THRESHOLD=0.75
AI_TIMEOUT_SECONDS=15
AI_RATE_LIMIT_PER_MIN=30

# --- App ---
PORT=8080
# Dev default is built in. Set your own (32+ characters) for anything shared.
# JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# --- Database: H2 file under ./data by default. For PostgreSQL: SPRING_PROFILES_ACTIVE=postgres ---
# SPRING_PROFILES_ACTIVE=postgres
# TICKETIQ_DB_URL=jdbc:postgresql://localhost:5432/ticketiq
# TICKETIQ_DB_USER=ticketiq
# TICKETIQ_DB_PASSWORD=ticketiq
