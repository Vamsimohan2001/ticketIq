{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "TicketIQ (Spring Boot)",
      "request": "launch",
      "mainClass": "com.ticketiq.app.TicketIqApplication",
      "projectName": "ticketiq-app",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "java",
      "name": "AI evaluation (writes docs/evaluation-report.md)",
      "request": "launch",
      "mainClass": "com.ticketiq.core.eval.EvaluationRunner",
      "projectName": "ticketiq-core",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
